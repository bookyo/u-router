# Edge 节点配置（复制为 .env 后按需修改）

PORT=7100
EDGE_ID=edge-01
# 对外访问地址（拼接上传响应里的 download_url），生产环境换成 https 域名
PUBLIC_BASE_URL=http://localhost:7100

STORAGE_DIR=./data/files
DB_PATH=./data/edge.db

# 与总控共享的 HMAC 密钥（总控 Edge 注册时的 token_secret），必须一致
TOKEN_SECRET=

# 上传响应里自签链接的有效期（秒）
TOKEN_TTL_SEC=86400

# 设置后 /api/*（除 /api/health）都需要 x-api-key；总控拉统计时也会带上
EDGE_API_KEY=

MAX_UPLOAD_BYTES=10737418240

# ---- PULL 拉取（文件分发）安全与资源限制 ----
# 默认拒绝私网/回环源（SSRF 防护）；Edge 之间走内网分发时置 true
PULL_ALLOW_PRIVATE_NET=false
# 同时进行的拉取任务数，超出的排队
PULL_MAX_CONCURRENT=2
# 单次尝试的整体超时（毫秒，默认 30 分钟，超时可断点续传重试）
PULL_TIMEOUT_MS=1800000
# 单个拉取任务的最大字节数（含 Content-Length 预检与流内硬限）
PULL_MAX_BYTES=10737418240

# Nginx 前置时置 true，通过 X-Accel-Redirect 交给反代发送大文件（Nginx 专属机制）
# 用 Caddy 时保持 false：Caddy 的 reverse_proxy 本身就是流式透传，由 Node 发送（支持 Range）
ENABLE_X_ACCEL=false
X_ACCEL_PREFIX=/internal

STATS_FLUSH_INTERVAL_MS=1000

# 生产环境置 production：500 错误将不再回传内部错误细节
# NODE_ENV=production
