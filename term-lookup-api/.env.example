# Generate a high-entropy value, for example:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
API_KEY=replace-with-a-long-random-secret
PORT=4444
HOST=127.0.0.1
# DATABASE_PATH=data/terms.sqlite
# Optional: actual trusted reverse proxy connection IPs, comma-separated.
# Only these peers may supply X-Forwarded-For. Leave empty for direct access.
# TRUST_PROXY_IPS=127.0.0.1,::1
