# 总控配置（复制为 .env 后按需修改）

PORT=7000
MONGO_URI=mongodb://127.0.0.1:27017/urouter

# Edge 的 base_url 是总控主动 fetch 的目标，默认只允许公网地址（防 SSRF 探测
# 内网/云元数据）。Edge 与总控同机或内网部署时置 true。
MASTER_ALLOW_PRIVATE_EDGE_URL=false

# 设置后所有 /api/* 需要携带 x-api-key 请求头（留空 = 开发模式不鉴权）
MASTER_API_KEY=

# 主动健康检测
HEALTH_CHECK_INTERVAL_SEC=15
HEALTH_TIMEOUT_MS=4000
UNHEALTHY_AFTER_FAILURES=3
OFFLINE_AFTER_FAILURES=10
RECOVERY_SUCCESSES=3

# 被动 delivery_ratio 判定
PASSIVE_CHECK_INTERVAL_SEC=30
DEGRADED_BELOW=0.9
UNHEALTHY_BELOW=0.7
RECOVERY_PASSES=2
PRIMARY_WINDOW=5m

# Edge 统计拉取
STATS_PULL_INTERVAL_SEC=60

# 下载 token 有效期（秒），分发 API 可用 ?ttl= 覆盖
DEFAULT_TOKEN_TTL_SEC=86400
MAX_TOKEN_TTL_SEC=604800

# 分配量内存聚合一批次落库间隔
DISPATCH_FLUSH_INTERVAL_MS=5000

# 分发接口每 IP 每分钟限流（0 = 关闭）。
# 公网部署强烈建议开启：恶意刷 links 会虚增分配量、把 delivery_ratio 压到
# 阈值以下，导致被动健康引擎把所有 Edge 误摘除（分发整体 503）。
LINKS_RATE_LIMIT_PER_MIN=0

# 文件分发（PULL 模式）编排
DISTRIBUTOR_INTERVAL_SEC=10
DISTRIBUTION_MAX_ATTEMPTS=3
# 分发源 token 有效期（秒）：要覆盖慢速 Edge 间传输 + 重试的整段时间
DISTRIBUTION_TOKEN_TTL_SEC=172800
# 单个目标无进展（字节不推进）多久后重派；需大于 Edge 的 PULL_TIMEOUT_MS
DISTRIBUTION_STALE_SEC=3600

# 生产环境置 production：500 错误将不再回传内部错误细节
# NODE_ENV=production
