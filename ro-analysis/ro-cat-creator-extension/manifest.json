{
  "manifest_version": 3,
  "name": "RO 创建猫角色（lastro api.html）",
  "version": "1.0.0",
  "description": "游戏角色选择页悬浮面板：一键向角色服明文发送 0x0A39 建角封包（job=4218 召唤师猫，可切人类初心者），自动选空闲槽位，监听 0x006B 角色表刷新确认成功。",
  "content_scripts": [
    {
      "matches": [
        "https://post.lastro.cn/ro/api.html*",
        "https://game.lastro.cn/ro/api.html*"
      ],
      "js": ["packet-sizes.js", "content-cat.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
